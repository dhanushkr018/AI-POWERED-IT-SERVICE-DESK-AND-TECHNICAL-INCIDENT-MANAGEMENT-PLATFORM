PORT=4000
CLIENT_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. This key bypasses Row Level Security. Never expose it to React.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for later phases. Phase 1 does not call Ollama or a rules engine.
# Leave OLLAMA_MODEL empty. Do not download a model until a later phase asks you to.
AI_PROVIDER=rules
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Classroom password used only by npm run seed for the demo accounts.
# Change it before using this project with real employee information.
SEED_DEMO_PASSWORD="CampusDesk#2026"
