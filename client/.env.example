# Public project URL from Supabase → Project Settings → API.
# The anon key is designed for the browser. Row Level Security limits what it can do.
# Never put the service-role key in this file or in any VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Leave this empty in local development. Vite forwards /api to the Express server.
# Set it only when the API is hosted on a different origin.
VITE_API_URL=
